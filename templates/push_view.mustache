{{!
    @template qbank_questionhub/push_view

    Push a new release of an own package, similar to a commit: changed questions with line diffs,
    release note and version number. Package settings are edited in the category list, not here.

    Example context (json):
    {"cancel_url": "#", "action_url": "#", "sesskey": "x", "package_title": "Kryptologie", "package_id": "ch.gym.inf.krypto", "version_value": "1.1.0", "files": []}
}}
<div class="qbank_questionhub_push mb-5">
    <a href="{{cancel_url}}" class="d-inline-block small mb-3"><i class="fa fa-arrow-left mr-1 me-1" aria-hidden="true"></i>{{#str}} review_back, qbank_questionhub {{/str}}</a>
    <h4 class="mb-1">
        <i class="fa fa-code-fork text-primary mr-2" aria-hidden="true"></i>{{#str}} push_heading, qbank_questionhub, {{package_title}} {{/str}}
    </h4>
    <p class="text-muted mb-4">
        <code>{{update_package_id}}</code> · {{#str}} push_current_version, qbank_questionhub, {{owned_version}} {{/str}}
        {{#category_name}} · {{#str}} push_source_category, qbank_questionhub, {{category_name}} {{/str}}{{/category_name}}
    </p>

    <div class="d-flex justify-content-between align-items-center flex-wrap mb-2">
        <h5 class="mb-0">{{#str}} push_files_heading, qbank_questionhub {{/str}}</h5>
        {{^files_unknown}}
        <span class="small">
            {{#str}} push_files_summary, qbank_questionhub, {{files_count}} {{/str}}
            <span class="text-success font-weight-bold ml-2 ms-2">+{{additions}}</span> <span class="text-danger font-weight-bold">−{{deletions}}</span>
        </span>
        {{/files_unknown}}
    </div>
    {{#files_unknown}}<div class="alert alert-secondary">{{#str}} push_changes_unknown, qbank_questionhub {{/str}}</div>{{/files_unknown}}
    {{#no_changes}}<div class="alert alert-info">{{#str}} push_no_changes, qbank_questionhub {{/str}}</div>{{/no_changes}}
    {{#same_content}}<p class="small text-muted">{{#str}} push_same_content, qbank_questionhub, {{same_content}} {{/str}}</p>{{/same_content}}

    {{> qbank_questionhub/diff_files }}

    <form method="post" action="{{action_url}}" class="card mt-4">
        <div class="card-body">
            <input type="hidden" name="sesskey" value="{{sesskey}}">
            <input type="hidden" name="courseid" value="{{courseid}}">
            <input type="hidden" name="bankcontextid" value="{{bankcontextid}}">
            {{#cmid}}<input type="hidden" name="cmid" value="{{cmid}}">{{/cmid}}
            <input type="hidden" name="categoryid" value="{{categoryid}}">
            <input type="hidden" name="updatepackageid" value="{{update_package_id}}">
            {{#github_push_note}}
            <div class="alert {{#github_push_linked}}alert-info{{/github_push_linked}}{{^github_push_linked}}alert-secondary{{/github_push_linked}} small mb-3">
                <i class="fa fa-github mr-1 me-1" aria-hidden="true"></i>{{github_push_note}}
            </div>
            {{/github_push_note}}
            <div class="form-group mb-3">
                <label for="release_notes" class="font-weight-bold">{{#str}} release_notes_label, qbank_questionhub {{/str}}</label>
                <textarea id="release_notes" name="release_notes" class="form-control" rows="3" required
                          placeholder="{{#str}} release_notes_placeholder, qbank_questionhub {{/str}}">{{release_notes}}</textarea>
            </div>
            <div class="form-group mb-3" style="max-width: 16rem;">
                <label for="package_version" class="font-weight-bold">{{#str}} package_version_label, qbank_questionhub {{/str}}</label>
                <input type="text" id="package_version" name="package_version" class="form-control" value="{{version_value}}" pattern="^\d+\.\d+\.\d+$" required>
                <small class="form-text text-muted">{{#str}} push_version_help, qbank_questionhub, {{owned_version}} {{/str}}</small>
            </div>
            <div class="d-flex justify-content-between align-items-center flex-wrap">
                <span class="small text-muted">{{#str}} push_settings_note, qbank_questionhub {{/str}}</span>
                <div>
                    <a href="{{cancel_url}}" class="btn btn-outline-secondary mr-2 me-2">{{#str}} cancel {{/str}}</a>
                    <button type="submit" name="action" value="download_xml" formnovalidate class="btn btn-outline-primary mr-2 me-2">
                        <i class="fa fa-download mr-1" aria-hidden="true"></i>{{#str}} download_xml_button, qbank_questionhub {{/str}}
                    </button>
                    <button type="submit" name="action" value="publish_hub" class="btn btn-primary">
                        <i class="fa fa-cloud-upload mr-1" aria-hidden="true"></i>{{#str}} push_submit, qbank_questionhub {{/str}}
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>
