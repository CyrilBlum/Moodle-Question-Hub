{{!
    @template qbank_questionhub/package_card

    Card of one Hub package in the search results: badges, summary, linked category with sync state and actions.

    Example context (json):
    {"id": "ch.gym.inf.krypto", "title": "Kryptologie", "summary": "Fragen zur Kryptologie", "subject_badge": "Informatik", "latest_version": "1.0.0", "license": "CC-BY-4.0", "stats": {"question_count": 12}, "preview_enabled": true}
}}
<div class="col-md-6 col-lg-4 mb-4">
    <div class="card h-100 shadow-sm border-light">
        <div class="card-body d-flex flex-column">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <span class="badge badge-primary bg-primary text-white">{{subject_badge}}</span>
                {{#is_private}}<span class="badge badge-warning bg-warning text-dark">{{#str}} private_package_badge, qbank_questionhub {{/str}}</span>
                    {{#can_access}}<span class="badge badge-secondary bg-secondary text-white">{{latest_version}}</span>{{/can_access}}
                {{/is_private}}
                {{^is_private}}<span class="badge badge-secondary bg-secondary text-white">{{latest_version}}</span>{{/is_private}}
            </div>
            <h5 class="card-title text-truncate" title="{{title}}">{{title}}</h5>
            <p class="card-text text-muted small flex-grow-1 qh-package-summary">
                {{#is_private}}{{#can_access}}{{summary}}{{/can_access}}{{^can_access}}{{#str}} private_package_summary, qbank_questionhub {{/str}}{{/can_access}}{{/is_private}}
                {{^is_private}}{{summary}}{{/is_private}}
            </p>
            <div class="mb-2">
                {{#canton_badge}}<span class="badge badge-info bg-info text-dark mr-1">{{canton_badge}}</span>{{/canton_badge}}
                {{#level_badge}}<span class="badge badge-dark bg-dark text-white mr-1">{{level_badge}}</span>{{/level_badge}}
                {{#is_private}}{{#can_access}}<span class="badge badge-light border text-muted mr-1">{{#str}} questions_count, qbank_questionhub, {{stats.question_count}} {{/str}}</span>
                <span class="badge badge-light border text-muted mr-1">{{license}}</span>{{/can_access}}{{/is_private}}
                {{^is_private}}<span class="badge badge-light border text-muted mr-1">{{#str}} questions_count, qbank_questionhub, {{stats.question_count}} {{/str}}</span>
                <span class="badge badge-light border text-muted mr-1">{{license}}</span>{{/is_private}}
                {{#preview_enabled}}<span class="badge badge-info bg-info text-dark">{{#str}} preview_button, qbank_questionhub {{/str}}</span>{{/preview_enabled}}
            </div>
            {{#author_info}}
            <div class="small text-muted mb-3">
                <i class="fa fa-user mr-1" aria-hidden="true"></i>{{author_info}}
            </div>
            {{/author_info}}
            <div class="mt-auto pt-2 border-top">
                {{#sync}}
                <div class="small text-muted mb-2">
                    <i class="fa fa-link mr-1" aria-hidden="true"></i>{{#str}} linked_to_category, qbank_questionhub {{/str}}
                    <a href="{{question_bank_url}}" title="{{#str}} open_category_questions, qbank_questionhub {{/str}}">{{name}}</a>
                    {{#package_version}}<span class="badge badge-light border ml-1">v{{package_version}}</span>{{/package_version}}
                    {{#is_package_source}}<span class="ml-1">· {{#str}} sync_source_label, qbank_questionhub {{/str}}</span>{{/is_package_source}}
                </div>
                <div class="d-flex flex-wrap align-items-center mb-2">
                    {{> qbank_questionhub/sync_status }}
                </div>
                {{/sync}}
                <div class="d-flex justify-content-between align-items-center flex-wrap">
                    {{#preview_enabled}}
                    <button type="button" class="btn btn-sm btn-outline-secondary qh-preview-btn" data-toggle="modal" data-bs-toggle="modal" data-target="#previewModal" data-bs-target="#previewModal" data-packageid="{{id}}" data-version="{{latest_version}}" data-title="{{title}}">
                        <i class="fa fa-eye mr-1" aria-hidden="true"></i>{{#str}} preview_button, qbank_questionhub {{/str}}
                    </button>
                    {{/preview_enabled}}
                    {{^preview_enabled}}<span></span>{{/preview_enabled}}
                    {{#sync}}
                    <span class="d-inline-flex align-items-center flex-wrap">
                        {{> qbank_questionhub/sync_actions }}
                    </span>
                    {{/sync}}
                    {{^sync}}
                    {{#is_private}}{{^can_access}}<a class="btn btn-sm btn-outline-primary" href="{{request_access_url}}" target="_blank" rel="noopener">{{#str}} request_access, qbank_questionhub {{/str}}</a>{{/can_access}}{{/is_private}}
                    {{^is_private}}<button type="button" class="btn btn-sm btn-primary qh-import-btn" data-toggle="modal" data-bs-toggle="modal" data-target="#importModal" data-bs-target="#importModal" data-packageid="{{id}}" data-version="{{latest_version}}" data-title="{{title}}" data-packageroot="{{package_root}}" data-variants="{{variants_json}}">
                        <i class="fa fa-download mr-1" aria-hidden="true"></i>{{#str}} import_short_button, qbank_questionhub {{/str}}
                    </button>{{/is_private}}
                    {{#is_private}}{{#can_access}}<button type="button" class="btn btn-sm btn-primary qh-import-btn" data-toggle="modal" data-bs-toggle="modal" data-target="#importModal" data-bs-target="#importModal" data-packageid="{{id}}" data-version="{{latest_version}}" data-title="{{title}}" data-packageroot="{{package_root}}" data-variants="{{variants_json}}"><i class="fa fa-download mr-1" aria-hidden="true"></i>{{#str}} import_short_button, qbank_questionhub {{/str}}</button>{{/can_access}}{{/is_private}}
                    {{/sync}}
                </div>
            </div>
        </div>
    </div>
</div>
