<div class="qbank_questionhub_browser mb-5">

    {{#has_account}}
    <div class="alert alert-info d-flex justify-content-between align-items-center mb-4">
        <div>
            <i class="fa fa-link mr-2" aria-hidden="true"></i>
            {{#str}} account_linked_as, qbank_questionhub, {{account_name}} {{/str}}
        </div>
        <a href="{{disconnect_url}}" class="btn btn-sm btn-outline-danger">
            {{#str}} disconnect_account_button, qbank_questionhub {{/str}}
        </a>
    </div>
    {{/has_account}}
    {{^has_account}}
    <div class="alert alert-light border d-flex justify-content-between align-items-center mb-4 flex-wrap">
        <div class="mb-2 mb-md-0">
            <i class="fa fa-info-circle mr-2 text-primary" aria-hidden="true"></i>
            {{#str}} account_not_linked, qbank_questionhub {{/str}}
        </div>
        <div class="d-flex align-items-center">
            <a href="{{connect_url}}" class="btn btn-sm btn-outline-primary mr-2">
                <i class="fa fa-sign-in mr-1" aria-hidden="true"></i>
                {{#str}} link_account_button, qbank_questionhub {{/str}}
            </a>
            <button class="btn btn-sm btn-outline-secondary" type="button" data-toggle="collapse" data-target="#patEntryForm" data-bs-toggle="collapse" data-bs-target="#patEntryForm">
                PAT
            </button>
        </div>
    </div>
    <div class="collapse mb-4" id="patEntryForm">
        <div class="card card-body bg-light">
            <form method="post" action="{{action_url}}" class="form-inline">
                <input type="hidden" name="sesskey" value="{{sesskey}}">
                <input type="hidden" name="action" value="save_pat">
                <label for="pat_token" class="mr-2">{{#str}} pat_token_label, qbank_questionhub {{/str}}</label>
                <input type="password" id="pat_token" name="pat_token" class="form-control mr-2 mb-2 mb-md-0" placeholder="mqh_pat_..." style="min-width: 300px;">
                <button type="submit" class="btn btn-primary">{{#str}} save_token, qbank_questionhub {{/str}}</button>
            </form>
        </div>
    </div>
    {{/has_account}}

    <!-- Search & Filter Form -->
    <div class="card bg-light border-0 mb-4 p-3 shadow-sm">
        <form method="get" action="{{browser_url}}" class="row g-2 align-items-center">
            <input type="hidden" name="courseid" value="{{courseid}}">
            {{#cmid}}<input type="hidden" name="cmid" value="{{cmid}}">{{/cmid}}
            {{#categoryid}}<input type="hidden" name="cat" value="{{categoryid}}">{{/categoryid}}

            <div class="col-md-4 mb-2">
                <input type="text" name="q" class="form-control" placeholder="{{#str}} search_placeholder, qbank_questionhub {{/str}}" value="{{query}}">
            </div>

            <div class="col-md-2 mb-2">
                <select name="subject" class="custom-select form-control">
                    <option value="">{{#str}} all_subjects, qbank_questionhub {{/str}}</option>
                    {{#subjects}}
                    <option value="{{id}}" {{#selected}}selected{{/selected}}>{{name_de}}</option>
                    {{/subjects}}
                </select>
            </div>

            <div class="col-md-2 mb-2">
                <select name="level" class="custom-select form-control">
                    <option value="">{{#str}} all_levels, qbank_questionhub {{/str}}</option>
                    <option value="GF" {{#level_gf_selected}}selected{{/level_gf_selected}}>GF (Grundlagenfach)</option>
                    <option value="SF" {{#level_sf_selected}}selected{{/level_sf_selected}}>SF (Schwerpunktfach)</option>
                    <option value="EF" {{#level_ef_selected}}selected{{/level_ef_selected}}>EF (Ergänzungsfach)</option>
                    <option value="FF" {{#level_ff_selected}}selected{{/level_ff_selected}}>FF (Freifach)</option>
                </select>
            </div>

            <div class="col-md-2 mb-2">
                <select name="canton" class="custom-select form-control">
                    <option value="">{{#str}} all_cantons, qbank_questionhub {{/str}}</option>
                    {{#cantons}}
                    <option value="{{code}}" {{#selected}}selected{{/selected}}>{{code}}</option>
                    {{/cantons}}
                </select>
            </div>

            <div class="col-md-2 mb-2 d-flex">
                <button type="submit" class="btn btn-primary mr-2 flex-grow-1">
                    <i class="fa fa-search mr-1" aria-hidden="true"></i>{{#str}} search_button, qbank_questionhub {{/str}}
                </button>
                <a href="{{reset_url}}" class="btn btn-outline-secondary" title="{{#str}} reset_filters, qbank_questionhub {{/str}}">
                    <i class="fa fa-times" aria-hidden="true"></i>
                </a>
            </div>
        </form>
    </div>

    <!-- Package Cards Grid -->
    <div class="row">
        {{#packages}}
            {{> qbank_questionhub/package_card }}
        {{/packages}}
        {{^packages}}
        <div class="col-12 py-5 text-center text-muted">
            <i class="fa fa-folder-open-o fa-3x mb-3 text-secondary" aria-hidden="true"></i>
            <h5>{{#str}} no_packages_found, qbank_questionhub {{/str}}</h5>
        </div>
        {{/packages}}
    </div>

    <!-- Pagination Controls -->
    {{#pagination.total_pages}}
    <nav class="mt-4" aria-label="Page navigation">
        <ul class="pagination justify-content-center">
            <li class="page-item {{^has_prev}}disabled{{/has_prev}}">
                <a class="page-link" href="{{prev_url}}">&laquo;</a>
            </li>
            <li class="page-item active">
                <span class="page-link">{{pagination.page}} / {{pagination.total_pages}}</span>
            </li>
            <li class="page-item {{^has_next}}disabled{{/has_next}}">
                <a class="page-link" href="{{next_url}}">&raquo;</a>
            </li>
        </ul>
    </nav>
    {{/pagination.total_pages}}

    {{#publish_categories.0}}
    <div class="card mt-5">
        <div class="card-header font-weight-bold">{{#str}} publish_category_heading, qbank_questionhub {{/str}}</div>
        <ul class="list-group list-group-flush">
            {{/publish_categories.0}}
            {{#publish_categories}}
            <li class="list-group-item d-flex justify-content-between align-items-center"
                style="padding-left: calc(1.25rem + {{indent}}rem); {{#is_child}}border-left: 3px solid #dee2e6;{{/is_child}}">
                <span>
                    {{#is_child}}<span class="text-muted mr-1">&#9492;</span>{{/is_child}}
                    <i class="fa {{#is_parent}}fa-folder-open{{/is_parent}}{{^is_parent}}fa-folder-o{{/is_parent}} text-muted mr-1" aria-hidden="true"></i>
                    <span {{^is_child}}class="font-weight-bold"{{/is_child}}>{{name}}</span>
                    <span class="badge badge-light border ml-2">{{own}}</span>
                    {{#has_sub_total}}<span class="small text-muted ml-1">({{total}} {{#str}} incl_subcategories, qbank_questionhub {{/str}})</span>{{/has_sub_total}}
                </span>
                <a href="{{url}}" class="btn btn-sm btn-outline-primary">{{#str}} publish_category_button, qbank_questionhub {{/str}}</a>
            </li>
            {{/publish_categories}}
            {{#publish_categories.0}}
        </ul>
    </div>
    {{/publish_categories.0}}

    {{#has_account}}
    <div class="card mt-4">
        <div class="card-header font-weight-bold">{{#str}} my_packages, qbank_questionhub {{/str}}</div>
        {{^has_my_packages}}
        <div class="card-body text-muted small">{{#str}} no_packages, qbank_questionhub {{/str}}</div>
        {{/has_my_packages}}
        <ul class="list-group list-group-flush">
            {{#my_packages}}
            <li class="list-group-item">
                <div class="d-flex justify-content-between align-items-start flex-wrap">
                    <div>
                        <strong>{{title}}</strong>
                        <div class="small text-muted">
                            {{id}} · v{{latest_version}} · {{downloads}} Downloads ·
                            {{#preview_on}}{{#str}} preview_on, qbank_questionhub {{/str}}{{/preview_on}}{{^preview_on}}{{#str}} preview_off, qbank_questionhub {{/str}}{{/preview_on}}
                        </div>
                        <div class="mt-1">
                            {{#versions}}
                            <form method="post" action="{{action_url}}" class="d-inline"
                                  onsubmit="return confirm('{{#str}} withdraw_version_confirm, qbank_questionhub {{/str}}');">
                                <input type="hidden" name="sesskey" value="{{sesskey}}">
                                <input type="hidden" name="action" value="withdraw_release">
                                <input type="hidden" name="packageid" value="{{id}}">
                                <input type="hidden" name="version" value="{{version}}">
                                <span class="badge badge-light border">{{version}}</span>
                                {{#can_withdraw}}
                                <button type="submit" class="btn btn-link btn-sm text-danger p-0 mr-2" title="{{#str}} withdraw_version, qbank_questionhub {{/str}}">&times;</button>
                                {{/can_withdraw}}
                            </form>
                            {{/versions}}
                        </div>
                    </div>
                    <button class="btn btn-sm btn-outline-secondary mr-1" type="button" data-toggle="collapse" data-bs-toggle="collapse"
                            data-target="#edit-{{domid}}" data-bs-target="#edit-{{domid}}">{{#str}} edit_settings, qbank_questionhub {{/str}}</button>
                    <form method="post" action="{{action_url}}"
                          onsubmit="return confirm('{{#str}} withdraw_package_confirm, qbank_questionhub {{/str}}');">
                        <input type="hidden" name="sesskey" value="{{sesskey}}">
                        <input type="hidden" name="action" value="withdraw_package">
                        <input type="hidden" name="packageid" value="{{id}}">
                        <button type="submit" class="btn btn-sm btn-outline-danger">{{#str}} withdraw_package, qbank_questionhub {{/str}}</button>
                    </form>
                </div>
                <div class="collapse mt-3" id="edit-{{domid}}">
                    <form method="post" action="{{action_url}}" class="border rounded p-3 bg-light">
                        <input type="hidden" name="sesskey" value="{{sesskey}}">
                        <input type="hidden" name="action" value="edit_package">
                        <input type="hidden" name="packageid" value="{{id}}">
                        <div class="form-group"><label>{{#str}} package_title_label, qbank_questionhub {{/str}}</label>
                            <input type="text" name="title" class="form-control" value="{{title}}" required></div>
                        <div class="form-group"><label>{{#str}} package_summary_label, qbank_questionhub {{/str}}</label>
                            <textarea name="summary" class="form-control" rows="3" required>{{summary}}</textarea></div>
                        <div class="form-group"><label>{{#str}} package_license_label, qbank_questionhub {{/str}}</label>
                            <select name="license" class="custom-select form-control">
                                <option value="CC-BY-4.0" {{#lic_by}}selected{{/lic_by}}>CC-BY-4.0</option>
                                <option value="CC-BY-SA-4.0" {{#lic_bysa}}selected{{/lic_bysa}}>CC-BY-SA-4.0</option>
                                <option value="CC0-1.0" {{#lic_cc0}}selected{{/lic_cc0}}>CC0-1.0</option>
                            </select></div>
                        <div class="form-group"><label>{{#str}} package_visibility_label, qbank_questionhub {{/str}}</label>
                            <select name="visibility" class="custom-select form-control">
                                <option value="public" {{#is_public}}selected{{/is_public}}>{{#str}} package_visibility_public, qbank_questionhub {{/str}}</option>
                                <option value="private" {{#is_private}}selected{{/is_private}}>{{#str}} package_visibility_private, qbank_questionhub {{/str}}</option>
                            </select>
                            <small class="form-text text-muted">{{#str}} private_package_summary, qbank_questionhub {{/str}}</small>
                        </div>
                        <div class="form-group"><label>{{#str}} package_grades_label, qbank_questionhub {{/str}}</label>
                            <select name="grades[]" class="custom-select form-control" multiple size="4">
                                <option value="GYM1" {{#g1}}selected{{/g1}}>GYM1</option>
                                <option value="GYM2" {{#g2}}selected{{/g2}}>GYM2</option>
                                <option value="GYM3" {{#g3}}selected{{/g3}}>GYM3</option>
                                <option value="GYM4" {{#g4}}selected{{/g4}}>GYM4</option>
                            </select></div>
                        <div class="form-group"><label>Tags</label>
                            <input type="text" name="tags" class="form-control" value="{{tags}}"></div>
                        <div class="form-check mb-3">
                            <input type="checkbox" class="form-check-input" name="preview_enabled" value="1" id="pv-{{domid}}" {{#preview_on}}checked{{/preview_on}}>
                            <label class="form-check-label" for="pv-{{domid}}">{{#str}} package_preview_label, qbank_questionhub {{/str}}</label>
                        </div>
                        <p class="text-muted small">{{#str}} version_immutable_note, qbank_questionhub {{/str}}</p>
                        <button type="submit" class="btn btn-primary btn-sm">{{#str}} save_settings, qbank_questionhub {{/str}}</button>
                    </form>
                </div>
            </li>
            {{/my_packages}}
        </ul>
    </div>
    {{/has_account}}

</div>

<!-- Modal: Preview Collection Questions -->
<div class="modal fade" id="previewModal" tabindex="-1" role="dialog" aria-labelledby="previewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="previewModalLabel">Fragensammlung-Vorschau</h5>
                <button type="button" class="close" data-dismiss="modal" data-bs-dismiss="modal" aria-label="Schliessen">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body" id="previewModalBody">
                <div class="text-center py-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="sr-only">Laden...</span>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal" data-bs-dismiss="modal">Schliessen</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Confirm Import Package -->
<div class="modal fade" id="importModal" tabindex="-1" role="dialog" aria-labelledby="importModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-md" role="document">
        <div class="modal-content">
            <form method="post" action="{{action_url}}">
                <input type="hidden" name="sesskey" value="{{sesskey}}">
                <input type="hidden" name="action" value="import_package">
                <input type="hidden" name="courseid" value="{{courseid}}">
                {{#cmid}}<input type="hidden" name="cmid" value="{{cmid}}">{{/cmid}}
                <input type="hidden" name="packageid" id="importModalPackageId" value="">
                <input type="hidden" name="version" id="importModalVersion" value="">
                <input type="hidden" name="title" id="importModalTitle" value="">

                <div class="modal-header">
                    <h5 class="modal-title" id="importModalLabel">{{#str}} import_confirm_title, qbank_questionhub {{/str}}</h5>
                    <button type="button" class="close" data-dismiss="modal" data-bs-dismiss="modal" aria-label="Schliessen">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <p>Möchten Sie das Paket <strong id="importModalTitleText"></strong> in diesen Kurs importieren?</p>

                    <div class="form-group mb-3">
                        <label for="importTargetCat">{{#str}} target_category, qbank_questionhub {{/str}}:</label>
                        <select name="targetcategoryid" id="importTargetCat" class="custom-select form-control">
                            {{#course_categories}}
                            <option value="{{id}}" {{#selected}}selected{{/selected}}>{{name}}</option>
                            {{/course_categories}}
                        </select>
                    </div>

                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" name="preservehierarchy" id="preserveHierarchy" value="1" checked>
                        <label class="form-check-label" for="preserveHierarchy">
                            {{#str}} import_preserve_hierarchy, qbank_questionhub {{/str}}
                        </label>
                    </div>

                    <div id="importDiagnosticsBox" class="alert alert-secondary mt-3 d-none">
                        <small id="importDiagnosticsText"></small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal" data-bs-dismiss="modal">Abbrechen</button>
                    <button type="submit" class="btn btn-primary" id="importSubmitBtn">
                        <i class="fa fa-download mr-1" aria-hidden="true"></i>{{#str}} import_button, qbank_questionhub {{/str}}
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
// Works on Moodle 4.5 (Bootstrap 4) and 5.0 (Bootstrap 5): the buttons open the modals through
// data attributes; this script only fills in the modal content.
document.addEventListener('DOMContentLoaded', function() {
    var hubUrl = '{{hub_url}}';

    function plainText(html) {
        var doc = new DOMParser().parseFromString(html || '', 'text/html');
        return (doc.body.textContent || '').trim();
    }

    document.querySelectorAll('.qh-preview-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
            var pkgId = this.getAttribute('data-packageid');
            var version = this.getAttribute('data-version');
            var title = this.getAttribute('data-title');
            var modalTitle = document.getElementById('previewModalLabel');
            var modalBody = document.getElementById('previewModalBody');
            modalTitle.textContent = 'Vorschau: ' + title;
            modalBody.textContent = 'Lade Vorschau vom Hub ...';

            fetch(hubUrl + '/api/v1/packages/' + encodeURIComponent(pkgId) + '/preview?version=' + encodeURIComponent(version))
                .then(function(res) {
                    return res.json().then(function(data) {
                        if (!res.ok) { throw new Error(data.message || ('HTTP ' + res.status)); }
                        return data;
                    });
                })
                .then(function(data) {
                    modalBody.textContent = '';
                    if (!data.questions || data.questions.length === 0) {
                        modalBody.textContent = 'Keine Fragen zur Vorschau verfügbar.';
                        return;
                    }
                    var list = document.createElement('div');
                    list.className = 'list-group';
                    data.questions.forEach(function(q, i) {
                        var item = document.createElement('div');
                        item.className = 'list-group-item';
                        var head = document.createElement('div');
                        head.className = 'd-flex w-100 justify-content-between';
                        var h = document.createElement('h6');
                        h.className = 'mb-1';
                        h.textContent = (i + 1) + '. ' + (q.name || 'Unbenannt');
                        var badge = document.createElement('span');
                        badge.className = 'badge badge-secondary bg-secondary';
                        badge.textContent = q.type || '';
                        head.appendChild(h);
                        head.appendChild(badge);
                        var text = document.createElement('div');
                        text.className = 'text-muted mt-2 small';
                        text.textContent = plainText(q.questiontextHtml || q.questiontext);
                        item.appendChild(head);
                        item.appendChild(text);
                        list.appendChild(item);
                    });
                    modalBody.appendChild(list);
                })
                .catch(function(err) {
                    modalBody.textContent = 'Vorschau nicht verfügbar: ' + err.message;
                });
        });
    });

    document.querySelectorAll('.qh-import-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
            var title = this.getAttribute('data-title');
            var version = this.getAttribute('data-version');
            document.getElementById('importModalPackageId').value = this.getAttribute('data-packageid');
            document.getElementById('importModalVersion').value = version;
            document.getElementById('importModalTitle').value = title;
            document.getElementById('importModalTitleText').textContent = title + ' (' + version + ')';
        });
    });
});
</script>
