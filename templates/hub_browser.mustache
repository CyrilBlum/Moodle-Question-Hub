<div class="qbank_questionhub_browser mb-5">

    {{#has_account}}
    <div class="alert alert-info d-flex justify-content-between align-items-center mb-4">
        <div>
            <i class="fa fa-link mr-2" aria-hidden="true"></i>
            {{#str}} account_linked_as, qbank_questionhub, {{account_name}} {{/str}}
        </div>
        <a href="{{disconnect_url}}" class="btn btn-sm btn-outline-danger">
            {{#str}} disconnect_account_button, qbank_questionhub {{/str}}
        </a>
    </div>
    {{/has_account}}
    {{^has_account}}
    <div class="alert alert-light border d-flex justify-content-between align-items-center mb-4 flex-wrap">
        <div class="mb-2 mb-md-0">
            <i class="fa fa-info-circle mr-2 text-primary" aria-hidden="true"></i>
            {{#str}} account_not_linked, qbank_questionhub {{/str}}
        </div>
        <div class="d-flex align-items-center">
            <a href="{{connect_url}}" class="btn btn-sm btn-outline-primary mr-2">
                <i class="fa fa-sign-in mr-1" aria-hidden="true"></i>
                {{#str}} link_account_button, qbank_questionhub {{/str}}
            </a>
            <button class="btn btn-sm btn-outline-secondary" type="button" data-toggle="collapse" data-target="#patEntryForm" data-bs-toggle="collapse" data-bs-target="#patEntryForm">
                PAT
            </button>
        </div>
    </div>
    <div class="collapse mb-4" id="patEntryForm">
        <div class="card card-body bg-light">
            <form method="post" action="{{action_url}}" class="form-inline">
                <input type="hidden" name="sesskey" value="{{sesskey}}">
                <input type="hidden" name="action" value="save_pat">
                <label for="pat_token" class="mr-2">{{#str}} pat_token_label, qbank_questionhub {{/str}}</label>
                <input type="password" id="pat_token" name="pat_token" class="form-control mr-2 mb-2 mb-md-0" placeholder="mqh_pat_..." style="min-width: 300px;">
                <button type="submit" class="btn btn-primary">{{#str}} save_token, qbank_questionhub {{/str}}</button>
            </form>
        </div>
    </div>
    {{/has_account}}

    <nav aria-label="Question Hub">
        <ul class="nav nav-tabs mb-4">
            <li class="nav-item"><a class="nav-link {{#section_browse}}active{{/section_browse}}" href="{{browse_tab_url}}" {{#section_browse}}aria-current="page"{{/section_browse}}>{{#str}} hub_tab_browse, qbank_questionhub {{/str}}</a></li>
            <li class="nav-item"><a class="nav-link {{#section_library}}active{{/section_library}}" href="{{library_tab_url}}" {{#section_library}}aria-current="page"{{/section_library}}>{{#str}} hub_tab_library, qbank_questionhub {{/str}}</a></li>
            <li class="nav-item"><a class="nav-link {{#section_my_packages}}active{{/section_my_packages}}" href="{{my_packages_tab_url}}" {{#section_my_packages}}aria-current="page"{{/section_my_packages}}>{{#str}} hub_tab_my_packages, qbank_questionhub {{/str}}</a></li>
        </ul>
    </nav>

    {{#has_multiple_bank_contexts}}
    <div class="form-group mb-4">
        <label class="font-weight-bold" for="qh-bank-context">{{#str}} question_bank_context, qbank_questionhub {{/str}}</label>
        <select id="qh-bank-context" class="custom-select form-control" onchange="window.location.href=this.value">
            {{#bank_contexts}}<option value="{{url}}" {{#selected}}selected{{/selected}}>{{name}}</option>{{/bank_contexts}}
        </select>
    </div>
    {{/has_multiple_bank_contexts}}

    {{#import_preview}}
    <div class="card border-primary mb-4" id="importPreview">
        <div class="card-header font-weight-bold">{{#str}} import_preview_heading, qbank_questionhub {{/str}}: {{title}}</div>
        <div class="card-body">
            <p>{{#str}} import_preview_explanation, qbank_questionhub {{/str}}</p>
            <p class="mb-2">
                <span class="badge badge-success">{{newcount}} {{#str}} import_preview_new, qbank_questionhub {{/str}}</span>
                <span class="badge badge-primary">{{updatecount}} {{#str}} import_preview_updated, qbank_questionhub {{/str}}</span>
                <span class="badge badge-secondary">{{unchangedcount}} {{#str}} import_preview_unchanged, qbank_questionhub {{/str}}</span>
                {{#conflictcount}}<span class="badge badge-danger bg-danger">{{conflictcount}} {{#str}} import_preview_conflicts, qbank_questionhub {{/str}}</span>{{/conflictcount}}
            </p>
            {{#new.0}}<h6>{{#str}} import_preview_new_heading, qbank_questionhub {{/str}}</h6><ul>{{#new}}<li>{{name}}{{#category}} <small class="text-muted">({{category}})</small>{{/category}}</li>{{/new}}</ul>{{/new.0}}
            {{#update.0}}<h6>{{#str}} import_preview_updated_heading, qbank_questionhub {{/str}}</h6><ul>{{#update}}<li>{{name}}{{#category}} <small class="text-muted">({{category}})</small>{{/category}}{{#uncertain}} <small class="text-warning">{{#str}} import_preview_uncertain, qbank_questionhub {{/str}}</small>{{/uncertain}}</li>{{/update}}</ul>{{/update.0}}
            {{#unchanged.0}}<h6>{{#str}} import_preview_unchanged_heading, qbank_questionhub {{/str}}</h6><ul>{{#unchanged}}<li>{{name}}{{#category}} <small class="text-muted">({{category}})</small>{{/category}}</li>{{/unchanged}}</ul>{{/unchanged.0}}
            <form method="post" action="{{action_url}}" class="d-inline">
                <input type="hidden" name="sesskey" value="{{sesskey}}">
                <input type="hidden" name="action" value="import_package">
                <input type="hidden" name="courseid" value="{{courseid}}">
                <input type="hidden" name="bankcontextid" value="{{bankcontextid}}">
                {{#cmid}}<input type="hidden" name="cmid" value="{{cmid}}">{{/cmid}}
                <input type="hidden" name="packageid" value="{{packageid}}">
                <input type="hidden" name="version" value="{{version}}">
                <input type="hidden" name="title" value="{{title}}">
                <input type="hidden" name="targetcategoryid" value="{{targetcategoryid}}">
                <input type="hidden" name="categorymode" value="{{categorymode}}">
                {{#updatechanged}}<input type="hidden" name="updatechanged" value="1">{{/updatechanged}}
                {{#conflict.0}}
                <div class="border border-danger rounded p-3 mb-3">
                    <h6 class="text-danger">{{#str}} import_preview_conflicts_heading, qbank_questionhub {{/str}}</h6>
                    <p class="small text-muted">{{#str}} import_preview_conflicts_help, qbank_questionhub {{/str}}</p>
                    {{#conflict}}
                    <fieldset class="mb-2">
                        <legend class="h6 mb-1">{{name}}{{#category}} <small class="text-muted">({{category}})</small>{{/category}}</legend>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="resolution[{{sourcekey}}]" id="res-keep-{{sourcekey}}" value="keep" checked>
                            <label class="form-check-label" for="res-keep-{{sourcekey}}">{{#str}} conflict_keep, qbank_questionhub {{/str}}</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="resolution[{{sourcekey}}]" id="res-hub-{{sourcekey}}" value="hub">
                            <label class="form-check-label" for="res-hub-{{sourcekey}}">{{#str}} conflict_hub, qbank_questionhub {{/str}}</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="resolution[{{sourcekey}}]" id="res-both-{{sourcekey}}" value="both">
                            <label class="form-check-label" for="res-both-{{sourcekey}}">{{#str}} conflict_both, qbank_questionhub, {{version}} {{/str}}</label>
                        </div>
                    </fieldset>
                    {{/conflict}}
                </div>
                {{/conflict.0}}
                <button type="submit" class="btn btn-primary">{{#str}} import_preview_confirm, qbank_questionhub {{/str}}</button>
            </form>
            <a href="{{browse_tab_url}}" class="btn btn-outline-secondary ml-2">{{#str}} import_preview_cancel, qbank_questionhub {{/str}}</a>
        </div>
    </div>
    {{/import_preview}}

    {{#has_duplicates}}
    <div class="alert alert-warning d-flex justify-content-between align-items-center flex-wrap mb-4">
        <span>{{#str}} duplicates_found, qbank_questionhub, {{duplicate_count}} {{/str}}</span>
        <form method="post" action="{{action_url}}" class="mt-2 mt-md-0"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="action" value="review_duplicates"><button type="submit" class="btn btn-sm btn-outline-danger">{{#str}} review_duplicates, qbank_questionhub {{/str}}</button></form>
    </div>
    {{/has_duplicates}}
    {{#has_duplicate_preview}}
    <div class="card border-warning shadow-sm mb-4">
        <div class="card-header bg-warning text-dark font-weight-bold"><i class="fa fa-clone mr-2" aria-hidden="true"></i>{{#str}} duplicate_review_heading, qbank_questionhub {{/str}}</div>
        <div class="card-body">
        <p>{{#str}} duplicate_review_intro, qbank_questionhub, {{duplicate_preview_count}} {{/str}}</p>
        <div id="qh-duplicate-accordion">
            {{#duplicate_categories}}
            <div class="card border mb-3">
                <div class="card-header bg-light p-0" id="{{id}}-heading">
                    <button class="btn btn-link btn-block text-left text-decoration-none d-flex justify-content-between align-items-center p-3" type="button" data-toggle="collapse" data-bs-toggle="collapse" data-target="#{{id}}" data-bs-target="#{{id}}" aria-expanded="{{#expanded}}true{{/expanded}}{{^expanded}}false{{/expanded}}" aria-controls="{{id}}">
                        <span><i class="fa fa-folder-open text-warning mr-2" aria-hidden="true"></i><strong>{{name}}</strong></span><i class="fa fa-chevron-down text-muted" aria-hidden="true"></i>
                    </button>
                </div>
                <div id="{{id}}" class="collapse {{#expanded}}show{{/expanded}}" aria-labelledby="{{id}}-heading" data-parent="#qh-duplicate-accordion">
                    <div class="card-body bg-white">
                        {{#groups}}
                        <div class="border rounded shadow-sm mb-4 overflow-hidden">
                            <div class="bg-light px-3 py-2 border-bottom"><strong>{{name}}</strong><span class="small text-muted ml-2">{{#str}} duplicate_matching_questions, qbank_questionhub {{/str}}</span></div>
                            <div class="table-responsive">
                                <table class="table table-hover mb-0 small">
                                    <thead class="thead-light"><tr><th>{{#str}} duplicate_suggested_action, qbank_questionhub {{/str}}</th><th>{{#str}} duplicate_question, qbank_questionhub {{/str}}</th><th>{{#str}} duplicate_question_version, qbank_questionhub {{/str}}</th><th>{{#str}} duplicate_dates, qbank_questionhub {{/str}}</th><th>{{#str}} duplicate_package, qbank_questionhub {{/str}}</th><th class="text-center">{{#str}} duplicate_preview, qbank_questionhub {{/str}}</th></tr></thead>
                                    <tbody>{{#rows}}
                                        <tr {{#is_keep}}class="table-success"{{/is_keep}}{{#is_delete}}class="table-danger"{{/is_delete}}>
                                            <td>{{#is_keep}}<span class="badge badge-success"><i class="fa fa-check mr-1" aria-hidden="true"></i>{{#str}} duplicate_keep_badge, qbank_questionhub {{/str}}</span>{{/is_keep}}{{#is_delete}}<span class="badge badge-danger"><i class="fa fa-trash mr-1" aria-hidden="true"></i>{{#str}} duplicate_delete_badge, qbank_questionhub {{/str}}</span>{{/is_delete}}</td>
                                            <td><strong>{{name}}</strong><div class="text-muted mt-1">ID {{question_id}} · {{#str}} duplicate_entry_id, qbank_questionhub {{/str}} {{entry_id}}</div></td>
                                            <td>v{{question_version}}</td>
                                            <td><div>{{created_at}}</div><div class="text-muted">{{modified_at}}</div></td>
                                            <td><div>{{package_title}}</div><div class="text-muted">{{package_id}} · v{{package_version}}</div><div class="text-muted">{{package_action}} · {{package_at}}</div></td>
                                            <td class="text-center"><button class="btn btn-sm btn-outline-secondary" type="button" title="{{#str}} duplicate_preview, qbank_questionhub {{/str}}" aria-controls="{{preview_id}}" data-toggle="collapse" data-bs-toggle="collapse" data-target="#{{preview_id}}" data-bs-target="#{{preview_id}}"><i class="fa fa-plus" aria-hidden="true"></i><span class="sr-only">{{#str}} duplicate_preview, qbank_questionhub {{/str}}</span></button></td>
                                        </tr>
                                        <tr><td colspan="6" class="p-0 border-0"><div id="{{preview_id}}" class="collapse bg-white border-top"><div class="p-3"><div class="small text-muted text-uppercase mb-2">{{#str}} duplicate_question_preview, qbank_questionhub {{/str}}</div>{{{preview_html}}}</div></div></td></tr>
                                    {{/rows}}</tbody>
                                </table>
                            </div>
                        </div>
                        {{/groups}}
                    </div>
                </div>
            </div>
            {{/duplicate_categories}}
        </div>
        <form method="post" action="{{action_url}}" onsubmit="return confirm('{{#str}} duplicate_delete_confirm, qbank_questionhub, {{duplicate_preview_count}} {{/str}}');"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="action" value="delete_duplicates"><input type="hidden" name="duplicatecategoryid" value="{{duplicate_category_id}}"><button type="submit" class="btn btn-danger"><i class="fa fa-trash mr-1" aria-hidden="true"></i>{{#str}} delete_duplicates, qbank_questionhub, {{duplicate_preview_count}} {{/str}}</button><a href="{{browse_tab_url}}" class="btn btn-outline-secondary ml-2">{{#str}} import_preview_cancel, qbank_questionhub {{/str}}</a></form>
    </div>
    </div>
    {{/has_duplicate_preview}}

    {{#show_browse}}
    <!-- Search & Filter Form -->
    <div class="card bg-light border-0 mb-4 p-3 shadow-sm">
        <form method="get" action="{{browser_url}}" class="row g-2 align-items-center">
            <input type="hidden" name="courseid" value="{{courseid}}">
            <input type="hidden" name="bankcontextid" value="{{bankcontextid}}">
            {{#cmid}}<input type="hidden" name="cmid" value="{{cmid}}">{{/cmid}}
            {{#categoryid}}<input type="hidden" name="cat" value="{{categoryid}}">{{/categoryid}}

            <div class="col-md-4 mb-2">
                <input type="text" name="q" class="form-control" placeholder="{{#str}} search_placeholder, qbank_questionhub {{/str}}" value="{{query}}">
            </div>

            <div class="col-md-2 mb-2">
                <select name="subject" class="custom-select form-control">
                    <option value="">{{#str}} all_subjects, qbank_questionhub {{/str}}</option>
                    {{#subjects}}
                    <option value="{{id}}" {{#selected}}selected{{/selected}}>{{name_de}}</option>
                    {{/subjects}}
                </select>
            </div>

            <div class="col-md-2 mb-2">
                <select name="level" class="custom-select form-control">
                    <option value="">{{#str}} all_levels, qbank_questionhub {{/str}}</option>
                    <option value="GF" {{#level_gf_selected}}selected{{/level_gf_selected}}>GF (Grundlagenfach)</option>
                    <option value="SF" {{#level_sf_selected}}selected{{/level_sf_selected}}>SF (Schwerpunktfach)</option>
                    <option value="EF" {{#level_ef_selected}}selected{{/level_ef_selected}}>EF (Ergänzungsfach)</option>
                    <option value="FF" {{#level_ff_selected}}selected{{/level_ff_selected}}>FF (Freifach)</option>
                </select>
            </div>

            <div class="col-md-2 mb-2">
                <select name="canton" class="custom-select form-control">
                    <option value="">{{#str}} all_cantons, qbank_questionhub {{/str}}</option>
                    {{#cantons}}
                    <option value="{{code}}" {{#selected}}selected{{/selected}}>{{code}}</option>
                    {{/cantons}}
                </select>
            </div>

            <div class="col-md-2 mb-2 d-flex">
                <button type="submit" class="btn btn-primary mr-2 flex-grow-1">
                    <i class="fa fa-search mr-1" aria-hidden="true"></i>{{#str}} search_button, qbank_questionhub {{/str}}
                </button>
                <a href="{{reset_url}}" class="btn btn-outline-secondary" title="{{#str}} reset_filters, qbank_questionhub {{/str}}">
                    <i class="fa fa-times" aria-hidden="true"></i>
                </a>
            </div>
        </form>
    </div>

    <!-- Package Cards Grid -->
    <div class="row">
        {{#packages}}
            {{> qbank_questionhub/package_card }}
        {{/packages}}
        {{^packages}}
        <div class="col-12 py-5 text-center text-muted">
            <i class="fa fa-folder-open-o fa-3x mb-3 text-secondary" aria-hidden="true"></i>
            <h5>{{#str}} no_packages_found, qbank_questionhub {{/str}}</h5>
        </div>
        {{/packages}}
    </div>

    <!-- Pagination Controls -->
    {{#pagination.total_pages}}
    <nav class="mt-4" aria-label="Page navigation">
        <ul class="pagination justify-content-center">
            <li class="page-item {{^has_prev}}disabled{{/has_prev}}">
                <a class="page-link" href="{{prev_url}}">&laquo;</a>
            </li>
            <li class="page-item active">
                <span class="page-link">{{pagination.page}} / {{pagination.total_pages}}</span>
            </li>
            <li class="page-item {{^has_next}}disabled{{/has_next}}">
                <a class="page-link" href="{{next_url}}">&raquo;</a>
            </li>
        </ul>
    </nav>
    {{/pagination.total_pages}}

    {{#publish_categories.0}}
    <div class="card mt-5">
        <div class="card-header font-weight-bold">{{#str}} publish_category_heading, qbank_questionhub {{/str}}</div>
        <ul class="list-group list-group-flush">
            {{/publish_categories.0}}
            {{#publish_categories}}
            <li class="list-group-item"
                style="padding-left: calc(1.25rem + {{indent}}rem); {{#is_child}}border-left: 3px solid #dee2e6;{{/is_child}}">
                <div class="d-flex justify-content-between align-items-center flex-wrap">
                    <span class="mb-1 mb-md-0">
                        {{#is_child}}<span class="text-muted mr-1">&#9492;</span>{{/is_child}}
                        <i class="fa {{#is_parent}}fa-folder-open{{/is_parent}}{{^is_parent}}fa-folder-o{{/is_parent}} text-muted mr-1" aria-hidden="true"></i>
                        <a href="{{question_bank_url}}" {{^is_child}}class="font-weight-bold"{{/is_child}} title="{{#str}} open_category_questions, qbank_questionhub {{/str}}">{{name}}</a>
                        <span class="badge badge-light border ml-2">{{own}}</span>
                        {{#has_sub_total}}<span class="small text-muted ml-1">({{total}} {{#str}} incl_subcategories, qbank_questionhub {{/str}})</span>{{/has_sub_total}}
                        {{#package_id}}
                        <div class="small text-muted mt-1">
                            <i class="fa fa-code-fork mr-1" aria-hidden="true"></i><a href="{{hub_package_url}}" class="text-muted" target="_blank" rel="noopener" title="{{#str}} open_hub_package, qbank_questionhub {{/str}}"><code>{{package_id}}</code></a>
                            {{#package_version}}<span class="badge badge-light border ml-1">v{{package_version}}</span>{{/package_version}}
                            {{#is_package_source}}<span class="ml-1">· {{#str}} sync_source_label, qbank_questionhub {{/str}}</span>{{/is_package_source}}
                        </div>
                        {{/package_id}}
                    </span>
                    <span class="d-inline-flex align-items-center flex-wrap">
                        {{> qbank_questionhub/sync_status }}
                        {{#has_duplicates}}
                        <form method="post" action="{{action_url}}" class="d-inline mr-1"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="action" value="review_duplicates"><input type="hidden" name="duplicatecategoryid" value="{{id}}"><button type="submit" class="btn btn-sm btn-outline-danger"><i class="fa fa-clone mr-1" aria-hidden="true"></i>{{#str}} review_duplicates_count, qbank_questionhub, {{duplicate_count}} {{/str}}</button></form>
                        {{/has_duplicates}}
                        {{> qbank_questionhub/sync_actions }}
                        {{#is_published}}
                            <form method="post" action="{{action_url}}" class="d-inline ml-1"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="action" value="unlink_category"><input type="hidden" name="categoryid" value="{{id}}"><button type="submit" class="btn btn-sm btn-outline-secondary" title="{{#str}} unlink_category_button, qbank_questionhub {{/str}}"><i class="fa fa-chain-broken" aria-hidden="true"></i><span class="sr-only">{{#str}} unlink_category_button, qbank_questionhub {{/str}}</span></button></form>
                        {{/is_published}}
                        {{^is_published}}
                            {{#is_unlinked}}<span class="small text-muted mr-2" title="{{#str}} category_unlinked_status_help, qbank_questionhub {{/str}}"><i class="fa fa-chain-broken mr-1 me-1" aria-hidden="true"></i>{{#str}} category_unlinked_status, qbank_questionhub {{/str}}</span>{{/is_unlinked}}
                            <a href="{{url}}" class="btn btn-sm btn-outline-primary"><i class="fa fa-cloud-upload mr-1" aria-hidden="true"></i>{{#str}} publish_category_button, qbank_questionhub {{/str}}</a>
                        {{/is_published}}
                        {{! Local category management, kept apart from the Hub actions. }}
                        <span class="d-inline-flex align-items-center ml-4 ms-4">
                            {{#can_edit_category}}
                            <button type="button" class="btn btn-sm btn-outline-secondary qh-edit-category mr-1 me-1"
                                    data-categoryid="{{id}}" data-parent="{{category_parent}}" data-sortorder="{{category_sortorder}}"
                                    data-questioncount="{{own}}" title="{{#str}} editcategory, question {{/str}}">
                                <i class="fa fa-pencil" aria-hidden="true"></i><span class="sr-only visually-hidden">{{#str}} editcategory, question {{/str}}</span>
                            </button>
                            {{/can_edit_category}}
                            {{#can_delete_category}}
                            <form method="post" action="{{action_url}}" class="d-inline" data-confirm="{{category_delete_confirm}}" onsubmit="return confirm(this.dataset.confirm);">
                                <input type="hidden" name="sesskey" value="{{sesskey}}">
                                <input type="hidden" name="action" value="delete_category">
                                <input type="hidden" name="categoryid" value="{{id}}">
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="{{#str}} category_delete_button, qbank_questionhub {{/str}}">
                                    <i class="fa fa-trash" aria-hidden="true"></i><span class="sr-only visually-hidden">{{#str}} category_delete_button, qbank_questionhub {{/str}}</span>
                                </button>
                            </form>
                            {{/can_delete_category}}
                        </span>
                    </span>
                </div>
                {{#pkg_settings}}
                <div class="collapse mt-3" id="edit-cat-{{domid}}">
                    <form method="post" action="{{action_url}}" class="border rounded p-3 bg-light">
                        <input type="hidden" name="sesskey" value="{{sesskey}}">
                        <input type="hidden" name="action" value="edit_package">
                        <input type="hidden" name="packageid" value="{{packageid}}">
                        <div class="form-group"><label>{{#str}} package_title_label, qbank_questionhub {{/str}}</label>
                            <input type="text" name="title" class="form-control" value="{{title}}" required></div>
                        <div class="form-group"><label>{{#str}} package_summary_label, qbank_questionhub {{/str}}</label>
                            <textarea name="summary" class="form-control" rows="3" required>{{summary}}</textarea></div>
                        <div class="form-group"><label>{{#str}} package_license_label, qbank_questionhub {{/str}}</label>
                            <select name="license" class="custom-select form-control">
                                <option value="CC-BY-4.0" {{#lic_by}}selected{{/lic_by}}>CC-BY-4.0</option>
                                <option value="CC-BY-SA-4.0" {{#lic_bysa}}selected{{/lic_bysa}}>CC-BY-SA-4.0</option>
                                <option value="CC0-1.0" {{#lic_cc0}}selected{{/lic_cc0}}>CC0-1.0</option>
                            </select></div>
                        <div class="form-group"><label>{{#str}} package_visibility_label, qbank_questionhub {{/str}}</label>
                            <select name="visibility" class="custom-select form-control">
                                <option value="public" {{#is_public}}selected{{/is_public}}>{{#str}} package_visibility_public, qbank_questionhub {{/str}}</option>
                                <option value="private" {{#is_private}}selected{{/is_private}}>{{#str}} package_visibility_private, qbank_questionhub {{/str}}</option>
                            </select>
                            <small class="form-text text-muted">{{#str}} private_package_summary, qbank_questionhub {{/str}}</small>
                        </div>
                        <div class="form-group"><label>{{#str}} package_level_label, qbank_questionhub {{/str}}</label>
                            <select name="subject_category" class="custom-select form-control" required>
                                <option value="GF" {{#level_gf}}selected{{/level_gf}}>GF (Grundlagenfach)</option>
