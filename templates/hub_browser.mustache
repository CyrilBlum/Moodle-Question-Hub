<template id="qh-category-naming-note">
    <div class="alert alert-warning qh-category-naming-note" role="note">{{{category_naming_note}}}</div>
</template>

<script>
// Edit a category in core's own category form (same form as Question bank > Categories), with a
// naming note for Question Hub links. RequireJS is available once the user clicks.
document.addEventListener('click', function(e) {
    var btn = e.target.closest('.qh-edit-category');
    if (!btn) {
        return;
    }
    require(['core_form/modalform'], function(ModalForm) {
        var args = {
            contextid: '{{bankcontextid}}',
            categoryid: btn.dataset.categoryid,
            sortorder: btn.dataset.sortorder,
            questioncount: btn.dataset.questioncount,
            parent: btn.dataset.parent + ',{{bankcontextid}}'
        };
        // Moodle 5.0 banks live in a mod_qbank module, 4.5 banks in the course context.
        if ('{{cmid}}') {
            args.cmid = '{{cmid}}';
        } else {
            args.courseid = '{{courseid}}';
        }
        var modalForm = new ModalForm({
            formClass: 'qbank_managecategories\\form\\question_category_edit_form',
            args: args,
            modalConfig: {title: btn.getAttribute('title'), large: true},
            saveButtonText: {{#quote}}{{#str}} savechanges {{/str}}{{/quote}},
            returnFocus: btn
        });
        modalForm.addEventListener(modalForm.events.LOADED, function() {
            // LOADED fires again after a server-side validation error re-renders the form.
            var form = modalForm.getFormNode();
            if (form && !form.parentNode.querySelector('.qh-category-naming-note')) {
                var note = document.getElementById('qh-category-naming-note').content.cloneNode(true);
                form.parentNode.insertBefore(note, form);
            }
        });
        modalForm.addEventListener(modalForm.events.FORM_SUBMITTED, function() {
            window.location.reload();
        });
        modalForm.show();
    });
});

// Works on Moodle 4.5 (Bootstrap 4) and 5.0 (Bootstrap 5): the buttons open the modals through
// data attributes; this script only fills in the modal content.
document.addEventListener('DOMContentLoaded', function() {
    var hubUrl = '{{hub_url}}';

    function plainText(html) {
        var doc = new DOMParser().parseFromString(html || '', 'text/html');
        return (doc.body.textContent || '').trim();
    }

    document.querySelectorAll('.qh-preview-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
            var pkgId = this.getAttribute('data-packageid');
            var version = this.getAttribute('data-version');
            var title = this.getAttribute('data-title');
            var modalTitle = document.getElementById('previewModalLabel');
            var modalBody = document.getElementById('previewModalBody');
            modalTitle.textContent = 'Vorschau: ' + title;
            modalBody.textContent = 'Lade Vorschau vom Hub ...';

            fetch(hubUrl + '/api/v1/packages/' + encodeURIComponent(pkgId) + '/preview?version=' + encodeURIComponent(version))
                .then(function(res) {
                    return res.json().then(function(data) {
                        if (!res.ok) { throw new Error(data.message || ('HTTP ' + res.status)); }
                        return data;
                    });
                })
                .then(function(data) {
                    modalBody.textContent = '';
                    if (!data.questions || data.questions.length === 0) {
                        modalBody.textContent = 'Keine Fragen zur Vorschau verfügbar.';
                        return;
                    }
                    var list = document.createElement('div');
                    list.className = 'list-group';
                    data.questions.forEach(function(q, i) {
                        var item = document.createElement('div');
                        item.className = 'list-group-item';
                        var head = document.createElement('div');
                        head.className = 'd-flex w-100 justify-content-between';
                        var h = document.createElement('h6');
                        h.className = 'mb-1';
                        h.textContent = (i + 1) + '. ' + (q.name || 'Unbenannt');
                        var badge = document.createElement('span');
                        badge.className = 'badge badge-secondary bg-secondary';
                        badge.textContent = q.type || '';
                        head.appendChild(h);
                        head.appendChild(badge);
                        var text = document.createElement('div');
                        text.className = 'text-muted mt-2 small';
                        text.textContent = plainText(q.questiontextHtml || q.questiontext);
                        item.appendChild(head);
                        item.appendChild(text);
                        list.appendChild(item);
                    });
                    modalBody.appendChild(list);
                })
                .catch(function(err) {
                    modalBody.textContent = 'Vorschau nicht verfügbar: ' + err.message;
                });
        });
    });

    var targetCategorySelect = document.getElementById('importTargetCat');
    var renameCategoryOption = document.getElementById('renameCategoryOption');
    var renameCategoryRadio = document.getElementById('categoryModeRename');
    var keepCategoryRadio = document.getElementById('categoryModeKeep');
    var packageRootName = '';

    function updateCategoryPlacementOptions() {
        var selected = targetCategorySelect.options[targetCategorySelect.selectedIndex];
        var isRoot = selected.getAttribute('data-is-root') === 'true' || selected.getAttribute('data-is-root') === '1';
        var canRename = packageRootName !== '' && !isRoot &&
            (selected.getAttribute('data-can-rename') === 'true' || selected.getAttribute('data-can-rename') === '1');
        renameCategoryOption.classList.toggle('d-none', !canRename);
        if (!canRename && renameCategoryRadio.checked) {
            keepCategoryRadio.checked = true;
        }
    }

    targetCategorySelect.addEventListener('change', updateCategoryPlacementOptions);

    // The settings form lives in the category list; bring it into view when opened from a Browse card.
    document.querySelectorAll('.qh-settings-toggle').forEach(function(btn) {
        btn.addEventListener('click', function() {
            var target = document.querySelector(this.getAttribute('data-target'));
            if (target && !this.closest('.list-group-item')) {
                setTimeout(function() { target.scrollIntoView({behavior: 'smooth', block: 'center'}); }, 350);
            }
        });
    });

    document.querySelectorAll('.qh-import-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
            var title = this.getAttribute('data-title');
            var version = this.getAttribute('data-version');
            packageRootName = this.getAttribute('data-packageroot') || '';
            document.getElementById('importModalPackageId').value = this.getAttribute('data-packageid');
            document.getElementById('importModalVersion').value = version;
            document.getElementById('importModalTitle').value = title;
            document.getElementById('importModalTitleText').textContent = title + ' (' + version + ')';
            document.getElementById('packageRootName').textContent = packageRootName;
            updateCategoryPlacementOptions();
        });
    });
});
</script>
