{{!
    @template qbank_questionhub/sync_actions

    Sync actions: review local changes (accept or reject), push (package source with local changes, unless a newer
    Hub release must be pulled first), publish again (withdrawn), pull (imported copy or own package), fork (imported
    package the account cannot publish to), merge request link (own fork) and package settings toggle.
    Shared by the category list, Browse cards, library and My packages; expects a category sync row as context.
    hide_settings_toggle: set where the category list (which holds the settings forms) is not on the page.
}}
{{#has_ahead}}{{^is_inherited_link}}
    <a href="{{review_url}}" class="btn btn-sm btn-outline-warning mr-1" title="{{#str}} review_button_help, qbank_questionhub {{/str}}">
        <i class="fa fa-list-alt mr-1" aria-hidden="true"></i>{{#str}} review_button, qbank_questionhub {{/str}}
    </a>
{{/is_inherited_link}}{{/has_ahead}}
{{#is_package_source}}{{#has_changes}}
    {{! A newer Hub release must be pulled first (the Hub refuses the push); the pull shows conflicts. }}
    {{^can_pull}}
    <a href="{{update_url}}" class="btn btn-sm btn-primary mr-1" title="{{#str}} push_button_help, qbank_questionhub, {{package_id}} {{/str}}">
        <i class="fa fa-cloud-upload mr-1" aria-hidden="true"></i>{{#str}} push_button, qbank_questionhub {{/str}}
    </a>
    {{/can_pull}}
    {{#can_pull}}<span class="small text-muted mr-2 me-2">{{#str}} pull_before_push, qbank_questionhub {{/str}}</span>{{/can_pull}}
{{/has_changes}}{{/is_package_source}}
{{#can_republish}}
    <a href="{{url}}" class="btn btn-sm btn-outline-primary mr-1" title="{{#str}} republish_button_help, qbank_questionhub {{/str}}">
        <i class="fa fa-cloud-upload mr-1" aria-hidden="true"></i>{{#str}} republish_button, qbank_questionhub {{/str}}
    </a>
{{/can_republish}}
{{#can_pull}}
<form method="post" action="{{action_url}}#importPreview" class="d-inline-flex mr-1">
    <input type="hidden" name="sesskey" value="{{sesskey}}">
    <input type="hidden" name="action" value="import_package">
    <input type="hidden" name="courseid" value="{{courseid}}">
    <input type="hidden" name="bankcontextid" value="{{bankcontextid}}">
    {{#cmid}}<input type="hidden" name="cmid" value="{{cmid}}">{{/cmid}}
    <input type="hidden" name="packageid" value="{{package_id}}">
    <input type="hidden" name="version" value="{{remote_version}}">
    <input type="hidden" name="title" value="{{pull_title}}">
    <input type="hidden" name="targetcategoryid" value="{{pull_target_id}}">
    <input type="hidden" name="categorymode" value="keep">
    <input type="hidden" name="updatechanged" value="1">
    <button type="submit" class="btn btn-sm btn-info mr-1" title="{{#str}} pull_button_help, qbank_questionhub, {{remote_version}} {{/str}}">
        <i class="fa fa-cloud-download mr-1" aria-hidden="true"></i>{{#str}} pull_button, qbank_questionhub, {{remote_version}} {{/str}}
    </button>
    <button type="submit" name="dryrun" value="1" class="btn btn-sm btn-outline-info" title="{{#str}} pull_preview_help, qbank_questionhub {{/str}}">
        <i class="fa fa-eye mr-1" aria-hidden="true"></i>{{#str}} pull_preview_button, qbank_questionhub {{/str}}
    </button>
</form>
{{/can_pull}}
{{#fork_hub_url}}
    <a href="{{fork_hub_url}}" class="btn btn-sm btn-outline-secondary mr-1" target="_blank" rel="noopener" title="{{#str}} fork_mr_button_help, qbank_questionhub, {{fork_of}} {{/str}}">
        <i class="fa fa-code-fork mr-1" aria-hidden="true"></i>{{#str}} fork_mr_button, qbank_questionhub {{/str}}
    </a>
{{/fork_hub_url}}
{{#can_fork}}
    {{! details/summary: works without JS and without IDs, so the same row can appear in several lists. }}
    <details class="d-inline-block mr-1 qh-fork" style="position: relative;">
        <summary class="btn btn-sm btn-outline-secondary" style="list-style: none;" title="{{#str}} fork_button_help, qbank_questionhub {{/str}}">
            <i class="fa fa-code-fork mr-1" aria-hidden="true"></i>{{#str}} fork_button, qbank_questionhub {{/str}}
        </summary>
        <form method="post" action="{{action_url}}" class="card card-body p-2 small text-left shadow-sm"
              style="position: absolute; right: 0; z-index: 20; width: 22rem; max-width: 90vw;">
            <input type="hidden" name="sesskey" value="{{sesskey}}">
            <input type="hidden" name="action" value="fork_package">
            <input type="hidden" name="courseid" value="{{courseid}}">
            <input type="hidden" name="bankcontextid" value="{{bankcontextid}}">
            {{#cmid}}<input type="hidden" name="cmid" value="{{cmid}}">{{/cmid}}
            <input type="hidden" name="categoryid" value="{{link_category_id}}">
            <input type="hidden" name="packageid" value="{{package_id}}">
            <p class="mb-2">{{#str}} fork_intro, qbank_questionhub, {{package_version}} {{/str}}</p>
            {{^fork_private_source}}
            <label class="mb-1">{{#str}} package_visibility_label, qbank_questionhub {{/str}}
                <select name="visibility" class="custom-select custom-select-sm form-control form-control-sm">
                    <option value="public">{{#str}} package_visibility_public, qbank_questionhub {{/str}}</option>
                    <option value="private">{{#str}} package_visibility_private, qbank_questionhub {{/str}}</option>
                </select>
            </label>
            {{/fork_private_source}}
            {{#fork_private_source}}<input type="hidden" name="visibility" value="private"><p class="text-muted mb-1">{{#str}} fork_private_note, qbank_questionhub {{/str}}</p>{{/fork_private_source}}
            <p class="text-muted mb-2">{{#str}} fork_license_note, qbank_questionhub {{/str}}</p>
            <button type="submit" class="btn btn-sm btn-primary">{{#str}} fork_submit, qbank_questionhub {{/str}}</button>
        </form>
    </details>
{{/can_fork}}
{{^hide_settings_toggle}}{{#is_package_source}}
    {{#pkg_settings}}
    <button class="btn btn-sm btn-outline-secondary qh-settings-toggle" type="button" data-toggle="collapse" data-bs-toggle="collapse"
            data-target="#edit-cat-{{domid}}" data-bs-target="#edit-cat-{{domid}}" title="{{#str}} edit_settings, qbank_questionhub {{/str}}">
        <i class="fa fa-cog" aria-hidden="true"></i><span class="sr-only">{{#str}} edit_settings, qbank_questionhub {{/str}}</span>
    </button>
    {{/pkg_settings}}
{{/is_package_source}}{{/hide_settings_toggle}}
