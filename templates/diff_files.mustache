{{!
    @template qbank_questionhub/diff_files

    Line diffs of changed questions, similar to a GitHub pull request: one collapsible card per question with a
    change bar, hunks with line numbers, marked changed words and expandable unchanged lines.
    Used by the push view, the review of local changes and the import preview (conflicts).

    Context variables:
    * files: results of \qbank_questionhub\release_diff::decorate()
    * has_toolbar: show the buttons to open or close all questions
    * files[].label: optional note next to the name
    * files[].old_label, files[].new_label: where the removed (−) and added (+) lines come from, shown as a legend
    * files[].is_rename, renamed_from, moved_label: renamed or moved question (badge R, previous name/path)
    * files[].preview_url, files[].edit_url: links to the local question

    Example context (json):
    {"has_toolbar": true, "files": []}
}}
<div class="qh-diffs" data-qh-diffs>
    {{#has_toolbar}}
    <div class="d-flex justify-content-end mb-2">
        <button type="button" class="btn btn-sm btn-outline-secondary mr-1 me-1" data-qh-diff-all="open">
            <i class="fa fa-plus-square-o mr-1" aria-hidden="true"></i>{{#str}} diff_expand_all, qbank_questionhub {{/str}}
        </button>
        <button type="button" class="btn btn-sm btn-outline-secondary" data-qh-diff-all="close">
            <i class="fa fa-minus-square-o mr-1" aria-hidden="true"></i>{{#str}} diff_collapse_all, qbank_questionhub {{/str}}
        </button>
    </div>
    {{/has_toolbar}}
    {{#files}}
    <details class="qh-file" id="{{domid}}" {{#open}}open{{/open}}>
        <summary>
            <i class="fa fa-chevron-right qh-chevron" aria-hidden="true"></i>
            {{#is_added}}<span class="badge badge-success bg-success">{{#str}} push_status_added, qbank_questionhub {{/str}}</span>{{/is_added}}
            {{#is_modified}}<span class="badge badge-warning bg-warning text-dark">{{#str}} push_status_modified, qbank_questionhub {{/str}}</span>{{/is_modified}}
            {{#is_removed}}<span class="badge badge-danger bg-danger">{{#str}} push_status_removed, qbank_questionhub {{/str}}</span>{{/is_removed}}
            {{#is_renamed}}<span class="badge badge-success bg-success">{{#str}} push_status_renamed, qbank_questionhub {{/str}}</span>{{/is_renamed}}
            {{#is_moved}}<span class="badge badge-success bg-success">{{#str}} push_status_moved, qbank_questionhub {{/str}}</span>{{/is_moved}}
            {{#is_rename}}<span class="qh-rename" title="{{#str}} diff_rename_help, qbank_questionhub {{/str}}">R</span>{{/is_rename}}
            <span class="qh-fname">{{name}}
                {{#renamed_from}}<span class="small text-muted font-weight-normal fw-normal d-block">{{#str}} diff_renamed_from, qbank_questionhub, {{renamed_from}} {{/str}}</span>{{/renamed_from}}
                {{#moved_label}}<span class="small text-muted font-weight-normal fw-normal d-block">{{moved_label}}</span>{{/moved_label}}
            </span>
            {{#label}}<span class="small text-muted">{{label}}</span>{{/label}}
            {{#preview_url}}<span class="qh-actions text-nowrap">
                <a href="{{preview_url}}" target="_blank" rel="noopener" class="btn btn-outline-secondary" title="{{#str}} duplicate_preview, qbank_questionhub {{/str}}"><i class="fa fa-search" aria-hidden="true"></i><span class="sr-only visually-hidden">{{#str}} duplicate_preview, qbank_questionhub {{/str}}</span></a>
                <a href="{{edit_url}}" class="btn btn-outline-secondary" title="{{#str}} edit {{/str}}"><i class="fa fa-pencil" aria-hidden="true"></i><span class="sr-only visually-hidden">{{#str}} edit {{/str}}</span></a>
            </span>{{/preview_url}}
            <span class="qh-stat">
                <span class="qh-stat-add">+{{additions}}</span> <span class="qh-stat-del">−{{deletions}}</span>
                <span class="qh-bar" aria-hidden="true">{{#bar}}<span class="{{#add}}qh-b-add{{/add}}{{#del}}qh-b-del{{/del}}"></span>{{/bar}}</span>
            </span>
        </summary>
        <div class="qh-body">
            {{#old_label}}
            <div class="qh-sides">
                <span class="qh-side qh-side-old"><b>−</b>{{old_label}}</span>
                <span class="qh-side qh-side-new"><b>+</b>{{new_label}}</span>
            </div>
            {{/old_label}}
            {{#too_large}}<p class="text-muted small p-3 mb-0">{{#str}} push_diff_too_large, qbank_questionhub {{/str}}</p>{{/too_large}}
            {{#no_content}}<p class="text-muted small p-3 mb-0">{{#str}} diff_removed_no_content, qbank_questionhub {{/str}}</p>{{/no_content}}
            {{#is_moved}}<p class="text-muted small p-3 mb-0">{{#str}} diff_moved_only, qbank_questionhub {{/str}}</p>{{/is_moved}}
            {{^too_large}}{{#hunks.0}}
            <table class="qh-diff">
                <colgroup><col class="qh-col-line"><col class="qh-col-line"><col class="qh-col-sign"><col></colgroup>
                {{#hunks}}
                {{#has_gap}}
                <tr class="qh-gap"><td colspan="4"><button type="button" class="qh-gap-toggle" data-qh-gap="{{gapid}}">
                    <i class="fa fa-arrows-v mr-1" aria-hidden="true"></i>{{#str}} diff_show_unchanged, qbank_questionhub, {{gap_count}} {{/str}}
                </button></td></tr>
                {{#gap}}
                <tr class="qh-hidden" data-qh-gap-row="{{gapid}}"><td class="qh-ln">{{old}}</td><td class="qh-ln">{{new}}</td><td class="qh-sign"> </td><td>{{text}}</td></tr>
                {{/gap}}
                {{/has_gap}}
                <tr class="qh-hunk"><td colspan="4">{{header}}</td></tr>
                {{#rows}}
                <tr class="{{#is_add}}qh-add{{/is_add}}{{#is_del}}qh-del{{/is_del}}"><td class="qh-ln">{{old}}</td><td class="qh-ln">{{new}}</td><td class="qh-sign">{{sign}}</td><td>{{#segments}}{{#changed}}<mark>{{text}}</mark>{{/changed}}{{^changed}}{{text}}{{/changed}}{{/segments}}</td></tr>
                {{/rows}}
                {{#has_tail}}
                <tr class="qh-gap"><td colspan="4"><button type="button" class="qh-gap-toggle" data-qh-gap="{{tailid}}">
                    <i class="fa fa-arrows-v mr-1" aria-hidden="true"></i>{{#str}} diff_show_unchanged, qbank_questionhub, {{tail_count}} {{/str}}
                </button></td></tr>
                {{#tail}}
                <tr class="qh-hidden" data-qh-gap-row="{{tailid}}"><td class="qh-ln">{{old}}</td><td class="qh-ln">{{new}}</td><td class="qh-sign"> </td><td>{{text}}</td></tr>
                {{/tail}}
                {{/has_tail}}
                {{/hunks}}
            </table>
            {{/hunks.0}}{{/too_large}}
        </div>
    </details>
    {{/files}}
</div>
