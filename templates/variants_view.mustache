{{!
    @template qbank_questionhub/variants_view

    Questions with the same name and type but different content in one category (e.g. a local question and the
    Hub version imported next to it): each group lists its questions with origin and use, links to preview and
    edit them, and diffs against question 1 with a legend naming both sides. The teacher chooses the question to
    keep per group (default: keep all); the others are deleted unless a quiz uses them. A used local question can
    instead take over the Hub question: its content becomes a new version and the separate Hub question is
    deleted. The category name links to its question list.
}}
<div class="qbank_questionhub_variants mb-5">
    <a href="{{return_url}}" class="d-inline-block small mb-3"><i class="fa fa-arrow-left mr-1 me-1" aria-hidden="true"></i>{{#str}} review_back, qbank_questionhub {{/str}}</a>
    <h4 class="mb-1"><i class="fa fa-clone text-warning mr-2" aria-hidden="true"></i>{{#str}} variants_heading, qbank_questionhub {{/str}}</h4>
    <div class="alert alert-light border my-3">{{#str}} variants_intro, qbank_questionhub {{/str}}</div>

    {{^has_groups}}<div class="alert alert-info">{{#str}} variants_none, qbank_questionhub {{/str}}</div>{{/has_groups}}

    {{#has_groups}}
    <form method="post" action="{{action_url}}" id="qh-variants-form">
        <input type="hidden" name="sesskey" value="{{sesskey}}">
        <div class="d-flex justify-content-between align-items-center flex-wrap mb-3">
            <h5 class="mb-0">{{#str}} variants_groups, qbank_questionhub, {{group_count}} {{/str}}</h5>
            <div>
                <button type="button" class="btn btn-sm btn-outline-secondary mr-1 me-1" data-qh-variants="hub">
                    <i class="fa fa-magic mr-1" aria-hidden="true"></i>{{#str}} variants_keep_hub, qbank_questionhub {{/str}}
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary" data-qh-variants="all">
                    {{#str}} variants_reset, qbank_questionhub {{/str}}
                </button>
            </div>
        </div>

        {{#groups}}
        <div class="card mb-3" data-qh-group="{{groupindex}}">
            <div class="card-header bg-light">
                <strong>{{name}}</strong>
                <span class="small text-muted ml-1 ms-1"><a href="{{category_url}}"><i class="fa fa-folder-open-o mr-1" aria-hidden="true"></i>{{categoryname}}</a> · {{qtype}}</span>
            </div>
            <div class="table-responsive">
                <table class="table table-sm mb-0 small">
                    <thead class="thead-light"><tr>
                        <th style="width:7rem">{{#str}} variants_keep, qbank_questionhub {{/str}}</th>
                        <th>{{#str}} duplicate_question, qbank_questionhub {{/str}}</th>
                        <th>{{#str}} variants_created, qbank_questionhub {{/str}}</th>
                        <th>{{#str}} variants_versions, qbank_questionhub {{/str}}</th>
                        <th>{{#str}} variants_origin, qbank_questionhub {{/str}}</th>
                    </tr></thead>
                    <tbody>
                    {{#entries}}
                    <tr data-qh-entry="{{entryid}}" {{#inuse}}data-qh-inuse="1"{{/inuse}} {{#is_merge_source}}data-qh-source="1"{{/is_merge_source}}>
                        <td>
                            <div class="form-check">
                                <input type="radio" class="form-check-input" name="keep[{{groupindex}}]" value="{{entryid}}" id="qh-keep-{{entryid}}"
                                    {{#is_hub_choice}}data-qh-hub="1"{{/is_hub_choice}}>
                                <label class="form-check-label" for="qh-keep-{{entryid}}">{{#str}} variants_keep_this, qbank_questionhub {{/str}}</label>
                            </div>
                            {{#can_merge}}
                            <div class="form-check">
                                <input type="radio" class="form-check-input" name="keep[{{groupindex}}]" value="m{{entryid}}" id="qh-merge-{{entryid}}" data-qh-merge="1">
                                <label class="form-check-label" for="qh-merge-{{entryid}}" title="{{#str}} variants_merge_help, qbank_questionhub {{/str}}">{{#str}} variants_merge_this, qbank_questionhub {{/str}}</label>
                            </div>
                            {{/can_merge}}
                            <span class="badge badge-success bg-success d-none" data-qh-fate="merge">{{#str}} variants_will_merge, qbank_questionhub {{/str}}</span>
                            <span class="badge badge-danger bg-danger d-none" data-qh-fate="merged">{{#str}} variants_will_be_merged, qbank_questionhub {{/str}}</span>
                            <span class="badge badge-danger bg-danger d-none" data-qh-fate="delete">{{#str}} variants_will_delete, qbank_questionhub {{/str}}</span>
                            <span class="badge badge-secondary bg-secondary d-none" data-qh-fate="inuse" title="{{#str}} variants_inuse_help, qbank_questionhub {{/str}}">{{#str}} variants_stays_inuse, qbank_questionhub {{/str}}</span>
                        </td>
                        <td class="text-nowrap">
                            <strong>{{#str}} variants_number, qbank_questionhub, {{number}} {{/str}}</strong>
                            <a href="{{preview_url}}" target="_blank" rel="noopener" class="btn btn-sm btn-outline-secondary ml-1 ms-1">
                                <i class="fa fa-search mr-1" aria-hidden="true"></i>{{#str}} duplicate_preview, qbank_questionhub {{/str}}</a>
                            <a href="{{edit_url}}" class="btn btn-sm btn-outline-secondary">
                                <i class="fa fa-pencil mr-1" aria-hidden="true"></i>{{#str}} edit {{/str}}</a>
                            <div class="text-muted">ID {{questionid}}{{#inuse}} · {{#str}} variants_inuse, qbank_questionhub {{/str}}{{/inuse}}</div>
                        </td>
                        <td>{{created}}<div class="text-muted">{{#str}} variants_modified, qbank_questionhub, {{modified}} {{/str}}</div></td>
                        <td>v{{version}} ({{versions}})</td>
                        <td>
                            {{#has_tracked}}<span class="badge badge-info bg-info text-white"><i class="fa fa-cloud-download mr-1" aria-hidden="true"></i>{{tracked}}</span>{{/has_tracked}}
                            {{^has_tracked}}<span class="text-muted">{{#str}} variants_local, qbank_questionhub {{/str}}</span>{{/has_tracked}}
                        </td>
                    </tr>
                    {{/entries}}
                    <tr>
                        <td colspan="5">
                            <div class="form-check">
                                <input type="radio" class="form-check-input" name="keep[{{groupindex}}]" value="0" id="qh-keep-all-{{groupindex}}" checked>
                                <label class="form-check-label text-muted" for="qh-keep-all-{{groupindex}}">{{#str}} variants_keep_all, qbank_questionhub {{/str}}</label>
                            </div>
                        </td>
                    </tr>
                    </tbody>
                </table>
            </div>
            <div class="card-body pt-2 pb-1">{{#diff}}{{> qbank_questionhub/diff_files }}{{/diff}}</div>
        </div>
        {{/groups}}

        <div class="d-flex justify-content-between align-items-center flex-wrap mt-4">
            <a href="{{return_url}}" class="btn btn-outline-secondary">{{#str}} review_back, qbank_questionhub {{/str}}</a>
            <button type="submit" class="btn btn-danger" data-confirm="{{#str}} variants_apply_confirm, qbank_questionhub {{/str}}">
                <i class="fa fa-check mr-1" aria-hidden="true"></i>{{#str}} variants_apply, qbank_questionhub {{/str}}
            </button>
        </div>
    </form>
    {{/has_groups}}
    {{^has_groups}}<a href="{{return_url}}" class="btn btn-outline-secondary">{{#str}} review_back, qbank_questionhub {{/str}}</a>{{/has_groups}}
</div>
{{#js}}
(function() {
    var form = document.getElementById('qh-variants-form');
    if (!form) {
        return;
    }
    // Marks what happens to each question of a group: kept, deleted, or kept because a quiz uses it.
    var update = function(group) {
        var chosen = group.querySelector('input[type="radio"]:checked');
        var keepall = !chosen || chosen.value === '0';
        var merge = !keepall && chosen.value.charAt(0) === 'm';
        var target = keepall ? '' : chosen.value.replace('m', '');
        group.querySelectorAll('tr[data-qh-entry]').forEach(function(row) {
            var kept = keepall || row.getAttribute('data-qh-entry') === target;
            var inuse = row.hasAttribute('data-qh-inuse');
            var merged = merge && row.hasAttribute('data-qh-source');
            row.classList.toggle('table-success', !keepall && kept);
            row.classList.toggle('table-danger', !kept && (!inuse || merged));
            row.querySelector('[data-qh-fate="merge"]').classList.toggle('d-none', !(merge && kept));
            row.querySelector('[data-qh-fate="merged"]').classList.toggle('d-none', !merged);
            row.querySelector('[data-qh-fate="delete"]').classList.toggle('d-none', kept || inuse || merged);
            row.querySelector('[data-qh-fate="inuse"]').classList.toggle('d-none', kept || !inuse);
        });
    };
    var groups = form.querySelectorAll('[data-qh-group]');
    groups.forEach(function(group) {
        group.addEventListener('change', function() {
            update(group);
        });
        update(group);
    });
    form.querySelectorAll('[data-qh-variants]').forEach(function(button) {
        button.addEventListener('click', function() {
            var hub = button.getAttribute('data-qh-variants') === 'hub';
            groups.forEach(function(group) {
                // A used local question takes over the Hub question; otherwise the Hub question is kept.
                var target = hub
                    ? (group.querySelector('input[data-qh-merge]') || group.querySelector('input[data-qh-hub]'))
                    : null;
                (target || group.querySelector('input[value="0"]')).checked = true;
                update(group);
            });
        });
    });
    form.addEventListener('submit', function(e) {
        var count = form.querySelectorAll('tr.table-danger').length;
        var message = form.querySelector('[data-confirm]').getAttribute('data-confirm').replace('{count}', count);
        if (!count || !window.confirm(message)) {
            e.preventDefault();
        }
    });
})();
{{/js}}
